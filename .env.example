# ---- ClickHouse connection ----
db_clickhouse_host=localhost
db_clickhouse_port=9000
db_clickhouse_user=analytic
db_clickhouse_pass=your_password_here
db_clickhouse_db=amazon

# ---- Docker Compose ----
CLICKHOUSE_USER=analytic
CLICKHOUSE_PASSWORD=your_password_here
CLICKHOUSE_DB=amazon

# ---- Ingestion config ----
clickhouse_schema=amazon
clickhouse_table=reviews
batch_size=500
max_chunk=500
max_workers=4
